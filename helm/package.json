{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "description": "AI chief-of-staff: Eisenhower quadrants + 3-3-3 + agile, powered by Gemini (Vertex AI) and LangGraph.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @helm/engine",
    "dev:server": "npm run dev --workspace @helm/server",
    "dev:web": "npm run dev --workspace @helm/web"
  },
  "engines": {
    "node": ">=20"
  }
}
