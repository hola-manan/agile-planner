# Helm server config. Copy to .env. With NO key set, the app runs in `mock`
# mode (heuristic enrichment) so you can try everything offline.

# Vertex AI Express key (serves Gemini). Paste your Express API key here:
GOOGLE_API_KEY=

# Backend: gemini (default when a key is present) | vertex | mock
HELM_AI_BACKEND=

# Models
HELM_MODEL_JUDGE=gemini-2.5-pro
HELM_MODEL_FAST=gemini-2.5-flash

PORT=8787
HELM_DB=helm.db
